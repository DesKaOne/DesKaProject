IND_DATADIR=/var/lib/indochain/testnet-seed
IND_NETWORK=testnet
IND_RPC_ADDR=:9011
IND_P2P_ADDR=:10011
IND_RPC=:9011
IND_P2P=:10011
IND_ADVERTISE_P2P=http://<PUBLIC_HOST>:10011
