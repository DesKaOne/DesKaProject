IDR_DATADIR=/var/lib/deskachain/testnet-miner
IDR_NETWORK=testnet
IDR_RPC_ADDR=:9011
IDR_P2P_ADDR=:10011
IDR_RPC=:8811
IDR_P2P=:9811
IDR_ADVERTISE_P2P=http://example.testnet.miner:9811
