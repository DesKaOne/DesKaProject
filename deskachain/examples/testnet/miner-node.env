IND_DATADIR=/var/lib/indochain/testnet-miner
IND_NETWORK=testnet
IND_RPC_ADDR=:9011
IND_P2P_ADDR=:10011
IND_RPC=:8811
IND_P2P=:9811
IND_ADVERTISE_P2P=http://example.testnet.miner:9811
IND_BOOTNODE=http://example.testnet.node:9811
IND_SEED_PEERS=http://example.testnet.node:9811
IND_SEED_FILE=/etc/indochain/testnet-seeds.txt
IND_PUBLIC_RPC=true
IND_ENABLE_MINER_RPC=true
IND_ENABLE_WALLET_RPC=false
IND_ENABLE_ADMIN_RPC=false
IND_ENABLE_SERVICE_RPC=false
IND_ENABLE_FAUCET_RPC=false
IND_CORS_ORIGINS=
