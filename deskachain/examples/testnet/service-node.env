IDR_DATADIR=/var/lib/deskachain/testnet-service-node
IDR_NETWORK=testnet
IDR_RPC_ADDR=127.0.0.1:9013
IDR_P2P_ADDR=:10013
IDR_RPC=127.0.0.1:9013
IDR_P2P=:10013
IDR_ADVERTISE_P2P=http://<PUBLIC_HOST>:10013
IDR_BOOTNODE=http://<SEED_HOST>:10011
IDR_SEED_PEERS=http://<SEED_HOST>:10011
IDR_SEED_FILE=/etc/deskachain/testnet-seeds.txt
IDR_PUBLIC_RPC=false
IDR_ENABLE_MINER_RPC=false
IDR_ENABLE_WALLET_RPC=false
IDR_ENABLE_ADMIN_RPC=false
IDR_ENABLE_SERVICE_RPC=true
IDR_ENABLE_FAUCET_RPC=false
