DKC_DATADIR=/var/lib/deskachain/testnet-faucet
DKC_NETWORK=testnet
DKC_RPC_ADDR=127.0.0.1:8911
DKC_P2P_ADDR=:9911
DKC_RPC=127.0.0.1:8911
DKC_P2P=:9911
DKC_ADVERTISE_P2P=http://example.testnet.faucet:9911
DKC_BOOTNODE=http://example.testnet.node:9811
DKC_SEED_PEERS=http://example.testnet.node:9811
DKC_SEED_FILE=/etc/deskachain/testnet-seeds.txt
DKC_PUBLIC_RPC=false
DKC_ENABLE_MINER_RPC=true
DKC_ENABLE_WALLET_RPC=false
DKC_ENABLE_ADMIN_RPC=false
DKC_ENABLE_SERVICE_RPC=true
DKC_ENABLE_FAUCET_RPC=true
DKC_FAUCET_ADDRESS=DKC_REPLACE_WITH_TESTNET_FAUCET_ADDRESS
DKC_FAUCET_AMOUNT=1000
DKC_FAUCET_MAX_PER_ADDRESS=2000
DKC_FAUCET_MIN_INTERVAL=1m
DKC_CORS_ORIGINS=
