IDR_DATADIR=/var/lib/deskachain/testnet-faucet
IDR_NETWORK=testnet
IDR_RPC_ADDR=127.0.0.1:8911
IDR_P2P_ADDR=:9911
IDR_RPC=127.0.0.1:8911
IDR_P2P=:9911
IDR_ADVERTISE_P2P=http://example.testnet.faucet:9911
IDR_BOOTNODE=http://example.testnet.node:9811
IDR_SEED_PEERS=http://example.testnet.node:9811
IDR_SEED_FILE=/etc/deskachain/testnet-seeds.txt
IDR_PUBLIC_RPC=false
IDR_ENABLE_MINER_RPC=true
IDR_ENABLE_WALLET_RPC=false
IDR_ENABLE_ADMIN_RPC=false
IDR_ENABLE_SERVICE_RPC=true
IDR_ENABLE_FAUCET_RPC=true
IDR_FAUCET_ADDRESS=IDR_REPLACE_WITH_TESTNET_FAUCET_ADDRESS
IDR_FAUCET_AMOUNT=1000
IDR_FAUCET_MAX_PER_ADDRESS=2000
IDR_FAUCET_MIN_INTERVAL=1m
IDR_CORS_ORIGINS=
