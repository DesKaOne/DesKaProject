IND_DATADIR=/var/lib/indochain/testnet-faucet
IND_NETWORK=testnet
IND_RPC_ADDR=127.0.0.1:8911
IND_P2P_ADDR=:9911
IND_RPC=127.0.0.1:8911
IND_P2P=:9911
IND_ADVERTISE_P2P=http://example.testnet.faucet:9911
IND_BOOTNODE=http://example.testnet.node:9811
IND_SEED_PEERS=http://example.testnet.node:9811
IND_SEED_FILE=/etc/indochain/testnet-seeds.txt
IND_PUBLIC_RPC=false
IND_ENABLE_MINER_RPC=true
IND_ENABLE_WALLET_RPC=false
IND_ENABLE_ADMIN_RPC=false
IND_ENABLE_SERVICE_RPC=true
IND_ENABLE_FAUCET_RPC=true
IND_FAUCET_ADDRESS=IND_REPLACE_WITH_TESTNET_FAUCET_ADDRESS
IND_FAUCET_AMOUNT=1000
IND_FAUCET_MAX_PER_ADDRESS=2000
IND_FAUCET_MIN_INTERVAL=1m
IND_CORS_ORIGINS=
