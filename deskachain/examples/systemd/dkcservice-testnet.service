[Unit]
Description=IndoChain Testnet Service Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/var/lib/indochain
EnvironmentFile=/etc/indochain/indoservice.env
ExecStart=/usr/local/bin/indoservice --rpc-url ${IND_SERVICE_RPC_URL} --address ${IND_SERVICE_ADDRESS} --endpoint ${IND_SERVICE_ENDPOINT} --state ${IND_SERVICE_STATE}
Restart=always
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
