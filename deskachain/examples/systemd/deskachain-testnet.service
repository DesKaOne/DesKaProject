[Unit]
Description=DesKaChain Testnet Node
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/deskachain
EnvironmentFile=/etc/deskachain/testnet.env
ExecStart=/opt/deskachain/deskachain --datadir=${IDR_DATADIR} --network=${IDR_NETWORK} node start --rpc=${IDR_RPC_ADDR} --p2p=${IDR_P2P_ADDR} --advertise-p2p=${IDR_ADVERTISE_P2P} --bootnode=${IDR_BOOTNODE} --seed-peers=${IDR_SEED_PEERS} --seed-file=${IDR_SEED_FILE} --public-rpc --enable-miner-rpc=${IDR_ENABLE_MINER_RPC} --enable-wallet-rpc=${IDR_ENABLE_WALLET_RPC} --enable-admin-rpc=${IDR_ENABLE_ADMIN_RPC} --enable-service-rpc=${IDR_ENABLE_SERVICE_RPC} --enable-faucet-rpc=${IDR_ENABLE_FAUCET_RPC}
Restart=always
RestartSec=5
LimitNOFILE=65535
KillSignal=SIGINT
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
